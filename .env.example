#--------------------------------------------------------------------
# Environment
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# App Configuration
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8080/'

#--------------------------------------------------------------------
# Landing Newsletter Site Configuration
#--------------------------------------------------------------------

# Unique identifier for this site/landing page instance
SITE_ID = my-newsletter

# External API endpoint for newsletter subscriptions
API_BASE_URL = https://api.yourdomain.com

# API authentication key
API_KEY = sk_live_your_api_key_here

# Google reCAPTCHA v3 site key (public)
RECAPTCHA_SITE_KEY = your_recaptcha_v3_site_key

#--------------------------------------------------------------------
# Analytics (Optional)
#--------------------------------------------------------------------

# Google Analytics 4 measurement ID
GA4_ID =

# Google Tag Manager container ID
GTM_ID =

#--------------------------------------------------------------------
# Encryption (CI4 default)
#--------------------------------------------------------------------

# encryption.key =

#--------------------------------------------------------------------
# Site Branding & Customization
#--------------------------------------------------------------------

# Site identity (used in meta tags, logo alt text, etc.)
siteConfig.siteName = "NewsLanding"
siteConfig.siteTagline = "Subscription Landing Template"

# Logo paths (relative to /public/)
siteConfig.logoPath = images/logos/logo-dark.svg
siteConfig.logoWhitePath = images/logos/logo-light.svg

# Color palette (injected as CSS custom properties for dynamic theming)
# - colorPrimary:       CTA / botones / highlights de marca
# - colorSecondary:     elementos secundarios de UI
# - colorAccent:        superficie decorativa (bg, borders) — cualquier tono
# - colorTextHighlight: énfasis de texto sobre fondo claro — REQUIERE contraste alto (AA)
# - colorBgAlt:         fondo alternado claro
# - colorBgAccent:      fondo oscuro (footer, secciones invertidas)
siteConfig.colorPrimary       = #e63946
siteConfig.colorSecondary     = #457b9d
siteConfig.colorAccent        = #f1faee
siteConfig.colorTextHighlight = #1d3557
siteConfig.colorBgAlt         = #f8f9fa
siteConfig.colorBgAccent      = #1d3557

# Image assets (filenames in /public/images/landing/)
siteConfig.imageHero = hero-landing.webp
siteConfig.imageFaq = faq-landing.webp
siteConfig.imageOptions1 = op1-landing.webp
siteConfig.imageOptions2 = op2-landing.webp

# Section visibility control (comma-separated)
# Available sections: header, hero, options, faq, invitation, footer
# Example: siteConfig.sectionsEnabled = header,hero,footer (omits options, faq, invitation)
siteConfig.sectionsEnabled = header,hero,options,faq,invitation,footer

#--------------------------------------------------------------------
# Logging
#--------------------------------------------------------------------

# logger.threshold = 4
